# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit credentials.

POLIMILLIONAIRE_API_URL=http://131.175.15.22:51111/
POLIMILLIONAIRE_USER=your_username_here
POLIMILLIONAIRE_PASSWORD=your_password_here

# Optional — where the SQLite question log lives.
# Default: ./data/questions.sqlite (gitignored).
# Team convention: point this at the shared Drive folder when running
# experiments you want to contribute to the group corpus.
# POLIMILLIONAIRE_DB_PATH=/path/to/shared/questions.sqlite
